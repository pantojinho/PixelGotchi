# PixelGochi — comidas, efeitos e ícones do menu

palette food
  R #FF3A4A
  G #3ED64C
  D #1C8A2A
  O #FF8A1A
  B #4FA8FF
  W #F4F4FF
  K #7A7A88
  P #FF8FB8
  Y #FFD62E
end

# melancia (capivara)
sprite food_melon food
RRRR
GRRG
.GG.
end

# peixe (gato) — cabeça pra esquerda, rabo em "V" à direita
sprite food_fish food
.B.B
BWBB
.B.B
end

# mosquinha (sapo)
sprite food_fly food
W.W
.K.
end

# minhoca (pintinho)
sprite food_worm food
.PP.
P..P
end

# cenoura (coelho)
sprite food_carrot food
.G.
OOO
.O.
.O.
end

# camarãozinho (axolote)
sprite food_shrimp food
.OO
O..
OO.
end

# ------------------------------------------------------------ EFEITOS
palette fx
  R #FF3A5C
  Z #7FC8FF
  Y #FFE14A
  W #FFFFFF
  N #B98CFF
  C #8A5A2E
  c #B07A44
  S #6CFF6C
  B #4FA8FF
end

sprite fx_heart fx
R.R
RRR
.R.
end

sprite fx_z fx
ZZ.
.Z.
.ZZ
end

sprite fx_note fx
.N
.N
NN
end

sprite fx_poop fx
.c.
CCc
end

sprite fx_sparkle fx
.Y.
YWY
.Y.
end

sprite fx_twinkle fx
W
end

sprite fx_alert fx
Y
Y
.
Y
end

sprite fx_sick fx
.S.
S.S
.S.
end

sprite fx_drop fx
B
B
end

sprite fx_halo fx
YYY
end

sprite fx_ball fx
RY
BS
end

sprite fx_pill fx
RRW
end

# setinhas piscando dos lados do ovo: "me chacoalha!"
sprite fx_arrow_l fx
.W
W.
.W
end

sprite fx_arrow_r fx
W.
.W
W.
end

anim fx_sparkle_anim 120 fx_sparkle fx_twinkle fx_sparkle fx_twinkle

# ------------------------------------------------------------ RIP
# Lápide com cruz, grama e uma florzinha; o fantasminha flutua por cima
# (animado no código). Depois passa "RIP" rolando com a fonte 3x5.
palette grave
  G #8A90A0
  L #2EA83C
  F #FF7FA6
end

# Cruz de cemitério (silhueta bem clara) na grama, com uma florzinha.
sprite grave grave
.G......
GGG.....
.G......
.G.F....
LLLLLLLL
end

palette ghost
  W #CFE3FF
  B #7FAAF0
end

sprite ghost0 ghost
.WWW.
WWWWW
W.W.W
WWWWW
B.B.B
end

sprite ghost1 ghost
.WWW.
WWWWW
W.W.W
WWWWW
.B.B.
end

anim ghost 350 ghost0 ghost1

# ------------------------------------------------------------ ÍCONES DO MENU
# No máximo 8x7: a linha de baixo é dos oito pontinhos de navegação.
# Cada ícone tem uma cor dominante própria pra dar pra reconhecer de relance:
# comida vermelha, brincar roxo, limpar azul-claro, remédio verde,
# dormir amarelo, carinho rosa, status colorido, voltar branco.
palette icons
  R #FF3A4A
  r #C8202E
  G #3ED64C
  g #1C8A2A
  C #8A4A1E
  W #FFFFFF
  V #9A5CFF
  b #7FD8FF
  Y #FFD62E
  O #FF8A1A
  P #FF6FA8
  Z #7FC8FF
end

# maçã com cabinho, folha e brilho
sprite icon_food icons
...CGG..
...C....
.RRRRRR.
RRRRRWRR
RRRRRRRR
.RRRRRr.
..RRrr..
end

# controle de videogame: cruz branca, botões vermelho e amarelo
sprite icon_play icons
.VVVVVV.
VVWVVVRV
VWWWVYVV
VVWVVVVV
VVV..VVV
VV....VV
end

# bolhas de sabão (uma grande com brilho, duas pequenas)
sprite icon_clean icons
......b.
.....b.b
.bbb..b.
b..Wb...
b...b.b.
b...b...
.bbb....
end

# cruz de farmácia
sprite icon_medicine icons
..GGGG..
..GWGG..
GGGGGGGG
GGGGGGGG
..GGGG..
..gggg..
end

# lua crescente + "z"
sprite icon_sleep icons
..YYY...
.YY..ZZZ
YY....Z.
YY...ZZZ
YY......
.YY.....
..YYY...
end

# coração com brilho
sprite icon_pet icons
.PP.PP.
PWPPPPP
PPPPPPP
.PPPPP.
..PPP..
...P...
end

# barrinhas nas cores das páginas do status (fome, alegria, energia, saúde)
sprite icon_status icons
......GG
......GG
....Y.GG
..P.Y.GG
R.P.Y.GG
R.P.Y.GG
end

# seta de voltar (↶): ponta à esquerda, faz a curva e volta por baixo
sprite icon_back icons
.W......
WWWWW...
.W...W..
......W.
......W.
.....W..
.WWWW...
end

# ------------------------------------------------------------ STATUS (5x5)
# Uma página por atributo: ícone em cima, barra de 8 LEDs embaixo.
sprite stat_hunger icons
...G.
.RRR.
RRRWR
RRRRR
.RRR.
end

sprite stat_happy icons
.P.P.
PPPPP
PPPPP
.PPP.
..P..
end

sprite stat_energy icons
..YY
.YY.
YYYY
.YY.
YY..
end

sprite stat_care icons
..G..
..G..
GGGGG
..G..
..G..
end
