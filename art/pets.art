  D #1C8A2A
  W #F4FFF0
  Y #CFFF6A
  R #FF4F6E
  T #4FA8FF
end

sprite frog_idle0 frog
.G..G.
GWGGWG
G.GG.G
DGGGGD
.DDDD.
YY..YY
end

sprite frog_throat frog
.G..G.
GWGGWG
G.GG.G
DGGGGD
.DYYD.
YY..YY
end

sprite frog_blink frog
.G..G.
GGGGGG
GDGGDG
DGGGGD
.DDDD.
YY..YY
end

sprite frog_walk1 frog
.G..G.
GWGGWG
G.GG.G
DGGGGD
Y.DD.Y
......
end

sprite frog_eat1 frog
.G..G.
GWGGWG
G.GG.G
DRRRRD
.DDDD.
YY..YY
end

sprite frog_sleep0 frog
......
.G..G.
GGGGGG
GDGGDG
.DDDD.
YY..YY
end

sprite frog_sleep1 frog
......
.G..G.
GGGGGG
GDGGDG
.DYYD.
YY..YY
end

sprite frog_happy frog
.G..G.
GDGGDG
GGGGGG
RGGGGR
.RRRR.
Y....Y
end

sprite frog_sad frog
......
.G..G.
GWGGWG
GTGG.G
GGGGGG
.DDDD.
end

sprite frog_hungry0 frog
.G..G.
GWGGWG
G.GG.G
DG..GD
.DRRD.
YY..YY
end

anim frog_idle   400 frog_idle0 frog_idle0 frog_throat frog_idle0 frog_throat frog_idle0 frog_idle0 frog_idle0
anim frog_blink  150 frog_blink
anim frog_walk   240 frog_idle0 frog_walk1
anim frog_eat    200 frog_idle0 frog_eat1
anim frog_sleep  900 frog_sleep0 frog_sleep1
anim frog_happy  280 frog_happy frog_idle0
anim frog_sad    800 frog_sad
anim frog_hungry 400 frog_hungry0 frog_idle0

