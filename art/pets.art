BEBEB
BBPBB
.BBB.
.B.B.
end

sprite cat_blink cat
B...B
BBBBB
BSBSB
BBPBB
.BBB.
.B.B.
end

sprite cat_walk1 cat
B...B
BBBBB
BEBEB
BBPBB
.BBB.
B...B
end

sprite cat_eat1 cat
B...B
BBBBB
BEBEB
BBPBB
.B.B.
.B.B.
end

sprite cat_sleep0 cat
.....
B...B
BBBBB
BSBSB
BBPBB
.BBB.
end

sprite cat_sleep1 cat
.....
B...B
BBBBB
BSBSB
BBPBB
BBBBB
end

sprite cat_happy cat
B...B
BBBBB
BSBSB
BBPBB
.BRB.
B...B
end

sprite cat_sad cat
.....
BBBBB
BEBEB
BTPBB
.BSB.
.B.B.
end

sprite cat_hungry0 cat
B...B
BBBBB
BEBEB
BBPBB
.B.B.
.BTB.
end

anim cat_idle   450 cat_idle0 cat_idle0 cat_idle0 cat_idle0 cat_ear cat_idle0 cat_idle0 cat_idle0
anim cat_blink  150 cat_blink
anim cat_walk   220 cat_idle0 cat_walk1
anim cat_eat    260 cat_idle0 cat_eat1
anim cat_sleep  900 cat_sleep0 cat_sleep1
