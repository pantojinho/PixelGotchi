# PixelGochi — pets
#
# Regras de pixel art pra matriz de LED 8x8 (ver art/README.md):
# - preto = LED apagado: nada de contorno escuro, a silhueta contra o
#   fundo é o que define a forma;
# - olhos são "buracos" (pixel apagado) ou um pixel claro;
# - 2 a 4 cores por bicho, bem saturadas;
# - bichos com ~5-6 px de largura: sobra espaço pra comida, balão e efeitos;
# - frames de um mesmo bicho ancoram pelo centro-inferior.
#
# Vocabulário de expressões (igual pra todos, pra ficar legível):
#   feliz   = olhos fechadinhos + boca/bochecha colorida
#   triste  = lágrima azul (T) embaixo do olho + orelhas/brânquias caídas
#   fome    = boca aberta (buraco) + babinha azul (T)
#   dormindo= olhos fechados, corpo mais baixo (os Zzz vêm do código)

# ------------------------------------------------------------ CAPIVARA
# De lado, olhando pra direita. Cabeça mais clara que o corpo pra separar
# as massas; orelhinha em cima; no "feliz" ganha a tangerina na cabeça.
palette capy
  B #B25A22
  L #DE9050
  D #6E300C
  O #FF8A00
  G #54B82E
  T #4FA8FF
end

sprite capy_idle0 capy
...D..
.BBLLL
BBBL.L
BBBLLD
.D..D.
end

sprite capy_ear capy
....D.
.BBLLL
BBBL.L
BBBLLD
.D..D.
end

sprite capy_blink capy
...D..
.BBLLL
BBBLDL
BBBLLD
.D..D.
end

sprite capy_walk1 capy
...D..
.BBLLL
BBBL.L
BBBLLD
D..D..
end

sprite capy_eat1 capy
......
.BBD..
BBBLLL
BBBL.L
.D..LD
end

sprite capy_sleep0 capy
......
...D..
.BBLLL
BBBLDL
BBBBLD
end

sprite capy_sleep1 capy
......
....D.
.BBLLL
BBBLDL
BBBBLD
end

sprite capy_happy capy
....G.
...DO.
.BBLLL
BBBLDL
BBBLLD
D....D
end

sprite capy_sad capy
......
.BBD..
BBBLLL
BBBL.L
BBBLTD
.D..D.
end

sprite capy_hungry0 capy
...D..
.BBLLL
BBBL.L
BBBL.D
.D.DT.
end

anim capy_idle   450 capy_idle0 capy_idle0 capy_idle0 capy_ear capy_idle0 capy_idle0 capy_idle0 capy_idle0
anim capy_blink  150 capy_blink
anim capy_walk   220 capy_idle0 capy_walk1
anim capy_eat    260 capy_idle0 capy_eat1
anim capy_sleep  900 capy_sleep0 capy_sleep1
anim capy_happy  300 capy_happy capy_idle0
anim capy_sad    800 capy_sad
anim capy_hungry 450 capy_hungry0 capy_idle0

# ------------------------------------------------------------ GATO
# De frente, cabeça de "emoji" com orelhas pontudas, olhos verdes e
