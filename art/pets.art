# ------------------------------------------------------------ OVOS
# Um único desenho de ovo, recolorido por bicho via sprite@paleta.
palette egg_base
  E #FFF1D2
  S #C9A27A
  H #FFFFFF
  C #7A5A3A
end
palette egg_capy
  E #FFE9C8
  S #B25A22
  H #FFFFFF
  C #6E300C
end
palette egg_cat
  E #EEF1F8
  S #7C87A0
  H #FFFFFF
  C #4A5268
end
palette egg_frog
  E #EFFFE6
  S #3ED64C
  H #FFFFFF
  C #1C8A2A
end
palette egg_chick
  E #FFF8D8
  S #FFB020
  H #FFFFFF
  C #C07A10
end
palette egg_bunny
  E #FAF6FF
  S #FF8FB8
  H #FFFFFF
  C #A07CB0
end
palette egg_axo
  E #FFEAF4
  S #FF2F86
  H #FFFFFF
  C #B03070
end

sprite egg0 egg_base
..EE..
.EEEE.
.HEEE.
EEESEE
ESEEEE
EEEESE
.EEEE.
end

sprite egg1 egg_base
..EE..
.EEEE.
.HEEE.
EEECEE
ESEEEE
EEEESE
.EEEE.
end

sprite egg2 egg_base
..EE..
.EECE.
.HECE.
EECCEE
ESEEEE
EEEESE
.EEEE.
end

sprite egg3 egg_base
..EE..
.ECCE.
CHECEC
ECCECE
ESEEEE
EEEESE
.EEEE.
end

anim capy_egg  700 egg0@egg_capy
anim cat_egg   700 egg0@egg_cat
anim frog_egg  700 egg0@egg_frog
anim chick_egg 700 egg0@egg_chick
anim bunny_egg 700 egg0@egg_bunny
anim axo_egg   700 egg0@egg_axo

# ------------------------------------------------------------ SELVAGENS
# Forma "selvagem" (depois de muito descuido): mesmos desenhos, paleta
# terrosa/suja. Gato e sapo ganham olho amarelo feroz; o axolote fica
# escuro, que é a cor dele na natureza.
palette capy_wild : capy
  B #6E4424
  L #8E6440
  D #2E1808
end
palette cat_wild : cat
  B #5C6272
  S #30364A
  P #9A4A60
  E #FFD21E
end
palette frog_wild : frog
  G #6E8E22
  D #34500C
  W #FFE24A
  Y #8EA238
end
palette chick_wild : chick
  Y #B8923A
  L #D8C07A
  O #9A4A10
  P #8E4A58
end
palette bunny_wild : bunny
  W #A88C6C
  G #7A624A
  P #A86070
end
palette axo_wild : axo
  P #5E6E3E
  M #7E2E52
  D #2E3A1E
  L #8E9E6A
end

pet capy  "Capivara" food=food_melon  wild=capy_wild side=1
pet cat   "Gato"     food=food_fish   wild=cat_wild
pet frog  "Sapo"     food=food_fly    wild=frog_wild
pet chick "Pintinho" food=food_worm   wild=chick_wild
pet bunny "Coelho"   food=food_carrot wild=bunny_wild
pet axo   "Axolote"  food=food_shrimp wild=axo_wild
